{
  "expo": {
    "name": "BloodConnect Mobile",
    "slug": "blood-donor-mobile",
    "scheme": "blooddonormobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bloodconnect.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bloodconnect.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BloodConnect to use your location to place donation requests, donor profile coordinates, and donor searches."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
